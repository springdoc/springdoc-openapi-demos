; Import into Cloudflare, then switch the nameservers at IONOS.
; Everything stays DNS-only except demos, which the worker route makes proxied.
$TTL 3600

; GitHub Pages. The apex only had one of the four addresses; the other three are added here.
springdoc.org.		3600	IN	A	185.199.108.153
springdoc.org.		3600	IN	A	185.199.109.153
springdoc.org.		3600	IN	A	185.199.110.153
springdoc.org.		3600	IN	A	185.199.111.153
www.springdoc.org.	3600	IN	CNAME	springdoc.github.io.

; IONOS mail.
springdoc.org.		3600	IN	MX	10 mx00.ionos.fr.
springdoc.org.		3600	IN	MX	10 mx01.ionos.fr.
autodiscover.springdoc.org.	3600	IN	CNAME	adsredir.ionos.info.
s1-ionos._domainkey.springdoc.org.	3600	IN	CNAME	s1.dkim.ionos.com.
s2-ionos._domainkey.springdoc.org.	3600	IN	CNAME	s2.dkim.ionos.com.
s42582890._domainkey.springdoc.org.	3600	IN	CNAME	s42582890.dkim.ionos.com.
_domainconnect.springdoc.org.	3600	IN	CNAME	_domainconnect.1and1.com.
springdoc.org.		3600	IN	TXT	"v=spf1 include:_spf-eu.ionos.com ~all"
_dmarc.springdoc.org.	3600	IN	TXT	"v=DMARC1; p=quarantine; rua=mailto:support@springdoc.org; ruf=mailto:support@springdoc.org; fo=1"

; Ownership proofs. Keep both: one of them backs the Cloud Run domain verification.
springdoc.org.		3600	IN	TXT	"google-site-verification=wa8f-r6XWgxDlJoX4aZqx2-RJhPikWgr-3wqn0PS0jo"
springdoc.org.		3600	IN	TXT	"google-site-verification=pCN12EG-_wTuSuvWnSBuAhIYoXKDXjimeZpxApNv6P0"
springdoc.org.		3600	IN	TXT	"OSSRH-50044"

; The demos front door. A placeholder address is fine: the worker route intercepts before origin.
demos.springdoc.org.	3600	IN	A	192.0.2.1
; IONOS gave this name a mailbox it never used; deny outright rather than inherit the apex policy.
demos.springdoc.org.	3600	IN	TXT	"v=spf1 -all"

; Dropped on purpose: the dead OCI hosts demos1 (158.101.191.70) and ci-cd
; (129.159.254.115), plus the mail records IONOS auto-created under both of them.
